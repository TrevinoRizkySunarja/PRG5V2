      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code !== 200) { pm.execution.setNextRequest(null); throw new Error(\"Onverwachte HTTP-status: \" + pm.response.code); }",
              "pm.test(\"Productlijst\", () => pm.expect(pm.response.json().data).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 POST product toevoegen",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{csrf}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"{{demo_title}}\",\n  \"description\": \"Product aangemaakt met Postman.\",\n  \"brand\": \"Logitech\",\n  \"category\": \"Muizen\",\n  \"price\": \"49.95\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "protocolProfileBehavior": {
        "followRedirects": false
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"product_id\");",
              "pm.collectionVariables.set(\"demo_title\", \"Postman \" + pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "if (pm.response.code !== 201) { pm.execution.setNextRequest(null); throw new Error(\"Onverwachte HTTP-status: \" + pm.response.code); }",
              "pm.collectionVariables.set(\"product_id\", pm.response.json().data.id);",
              "pm.test(\"Product opgeslagen\", () => pm.expect(pm.response.json().data.title).to.eql(pm.collectionVariables.get(\"demo_title\")));"
            ]
          }
        }
      ]
    },
